# Kokoland (Next.js) — points at DishData's Supabase project (single backend).
# Copy to .env.local and fill in DishData's project values, then restart `npm run dev`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DISHDATA-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dishdata-anon-public-key

# Org slug for this restaurant inside DishData. This is "kokoland-berlin",
# not "kokoland" — verify against `select slug from orgs` if it ever changes.
NEXT_PUBLIC_DISHDATA_SLUG=kokoland-berlin

# Base URL of the DishData app (for the server-side payment proxy in Phase 3).
DISHDATA_API_URL=https://app.dishdata.com
